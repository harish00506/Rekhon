# Python (issue-doc generator tooling)
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Android / Gradle / IDE (populated when issue 1.1 scaffolds the build)
.gradle/
build/
local.properties
.idea/
*.iml
.cxx/
captures/

# Kotlin compiler working directory and crash logs (governance audit G-23).
.kotlin/

# MSYS/Git Bash writes these when a native tool crashes. They are transient
# debris from the developer's shell, never part of a build.
*.stackdump

# Local TLS for the §22 market-data proxy (issue 6.7), all of it generated by
# `./gradlew :backend:devTls`. The private keys never leave the machine that made them, and the
# debug trust anchor is deliberately NOT committed: a checked-in <debug-overrides> certificate would
# widen what every contributor's debug build trusts, to no benefit, and a fresh clone should build
# exactly as it does today — with no overrides at all.
backend/local/
app/src/debug/
