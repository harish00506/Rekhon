    <string name="notification_channel_critical_money">அவசர நிதி நிகழ்வுகள்</string>
    <string name="notification_channel_critical_money_description">செலுத்த வேண்டிய நாள் நெருங்கும் கட்டணங்கள். அமைதி நேரத்திலும் வரக்கூடிய ஒரே அறிவிப்புகள்.</string>
    <string name="notification_channel_debt_discipline">கார்டும் கடனும்</string>
    <string name="notification_channel_debt_discipline_description">ஒரு கார்டு தன் வரம்பில் பெரும் பகுதியைப் பயன்படுத்தினால் ஒவ்வொரு அறிக்கைக்கும் ஒருமுறை சொல்கிறது.</string>
    <string name="card_due_title">%1$s கட்டணம் %2$d நாட்களில் செலுத்த வேண்டும்</string>
    <string name="card_due_title_today">%1$s கட்டணம் இன்று செலுத்த வேண்டும்</string>
    <string name="card_due_body">%1$s செலுத்த வேண்டும். குறைந்தபட்சம் %2$s.</string>
    <string name="card_due_body_no_minimum">இந்த அறிக்கையில் %1$s செலுத்த வேண்டும்.</string>
    <string name="card_due_title_blurred">%1$s கட்டணம் விரைவில் செலுத்த வேண்டும்</string>
    <string name="card_due_body_blurred">தொகையைப் பார்க்க ஆப்பைத் திறங்கள்.</string>
