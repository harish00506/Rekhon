    <string name="notification_channel_budget_alerts_description">ஒரு வகை தன் பட்ஜெட்டில் 80%% ஐ எட்டும்போது ஒருமுறையும், 100%% ஐ எட்டும்போது ஒருமுறையும் சொல்கிறது.</string>
