    <string name="card_utilisation_body">இந்த அறிக்கையில் %2$s இல் %1$s பயன்படுத்தப்பட்டுள்ளது.</string>
    <string name="card_utilisation_title_blurred">%1$s தன் வரம்பில் பெரும்பகுதியைப் பயன்படுத்துகிறது</string>
    <string name="card_utilisation_body_blurred">நிலைமையைப் பார்க்க ஆப்பைத் திறங்கள்.</string>
    <string name="notification_channel_ai_insights">நுண்ணறிவுகள்</string>
    <string name="notification_channel_ai_insights_description">உங்கள் பணம் குறித்து செயல்படத்தக்க கண்டுபிடிப்புகள். ஒரு நாளைக்கு அதிகபட்சம் இரண்டு சாதாரண அறிவிப்புகள், இரவு 10 முதல் காலை 8 வரை ஒருபோதும் இல்லை.</string>
    <string name="notification_channel_maintenance">பராமரிப்பும் புதுப்பித்தலும்</string>
    <string name="notification_channel_maintenance_description">வரவிருக்கும் சர்வீஸ், காப்பீடு, சந்தா புதுப்பித்தல்கள்.</string>
    <string name="notification_channel_goal_events">இலக்குகள்</string>
    <string name="notification_channel_goal_events_description">ஓர் இலக்கு தன் திட்டத்தைவிடப் பின்தங்கும்போது.</string>
    <string name="notification_channel_habit">தினசரி பழக்கங்கள்</string>
    <string name="notification_channel_habit_description">செலவைப் பதிவு செய்ய மென்மையான நினைவூட்டல்கள். நீங்கள் கேட்காதவரை அணைந்தே இருக்கும்.</string>
    <string name="insight_crunch_title">%1$s அன்று பணம் பற்றாக்குறையாகலாம்</string>
    <plurals name="insight_crunch_body">
        <item quantity="one">அன்று சுமார் %2$s மிஞ்சும், அது உங்கள் %3$s இருப்புக்குக் கீழே.</item>
        <item quantity="other">%1$d நாட்கள் உங்கள் %3$s இருப்புக்குக் கீழே செல்கின்றன, மிகக் குறைந்த நாளில் சுமார் %2$s மிஞ்சும்.</item>
    </plurals>
    <string name="insight_crunch_title_blurred">விரைவில் பணம் பற்றாக்குறையாகலாம்</string>
    <string name="insight_crunch_body_blurred">நாட்களையும் தொகைகளையும் பார்க்க ஆப்பைத் திறங்கள்.</string>
    <string name="insight_goal_title">%1$s பின்தங்குகிறது</string>
    <string name="insight_goal_body">%2$s க்குள் இலக்கை எட்ட மாதம் இன்னும் %1$s தேவை.</string>
    <string name="insight_goal_body_blurred">எவ்வளவு தேவை எனப் பார்க்க ஆப்பைத் திறங்கள்.</string>
