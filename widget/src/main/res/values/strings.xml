<?xml version="1.0" encoding="utf-8"?>
<!--
  Why:  CLAUDE.md §21.6 — every user-visible string lives here, never in a composable. Issue 5.5
        widened the `CfoHardcodedUiString` lint detector to cover `/widget/`, so a literal in a
        Glance `Text(...)` in this module now fails the build rather than merely being noticed.
  Note: the widget shows no sentence containing a count, so there is no ICU plural here yet. There
        is also no amount: amounts are formatted by `MoneyFormatter`, never assembled from a string.
-->
<resources>

    <!-- Issue 5.5: the home-screen widget. `_label` is what the user reads above each figure;
         `_title` names the widget in the launcher's picker; `_description` is the one-line blurb
         beneath it there. `_pending` is what stands in for a figure no engine has produced yet —
         it exists so the widget never renders ₹0.00 as if it were an answer (P-03). -->
    <string name="widget_title">AI Personal CFO</string>
    <string name="widget_description">Your Safe-to-Spend and net worth, at a glance.</string>
    <string name="widget_safe_to_spend_label">Safe to spend</string>
    <string name="widget_net_worth_label">Net worth</string>
    <string name="widget_pending">Not yet worked out</string>

</resources>
