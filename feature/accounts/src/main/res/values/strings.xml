<?xml version="1.0" encoding="utf-8"?>
<!--
  Why:  §21.6 puts every user-visible string in resources — a hardcoded one cannot be translated
        and cannot be checked for length at 200% font. `CfoHardcodedUiString` (issue 1.5) fails the
        build on a literal in a :feature:* composable, so this file is not optional.
  What: the accounts list, the editor, and the eleven FR-ACC-001 type labels.
  Result: the whole feature\'s copy in one reviewable place.
  Changelog: 2026-07-28 — Created for issue 2.5.
-->
<resources>
    <string name="accounts_title">Accounts</string>
    <string name="accounts_empty_title">No accounts yet</string>
    <string name="accounts_empty_body">Add a bank account, a card or a loan and the app can start
        tracking what you actually have.</string>
    <string name="accounts_add">Add account</string>
    <string name="accounts_show_archived">Show closed accounts</string>
    <string name="accounts_archive">Close account</string>
    <string name="accounts_unarchive">Reopen account</string>
    <string name="accounts_delete">Delete</string>
    <string name="accounts_archived_label">Closed</string>
    <!-- The list row\'s second line: the institution when there is one, then what it opened with. -->
    <string name="accounts_row_supporting">%1$s · opened with %2$s</string>
    <string name="accounts_row_supporting_no_institution">Opened with %1$s</string>
    <string name="accounts_error_dismiss">Dismiss</string>
    <string name="accounts_error_storage">We couldn\'t reach your saved accounts. Try again.</string>
    <string name="accounts_error_not_found">That account is no longer there.</string>
    <string name="accounts_error_generic">Something went wrong. Try again.</string>

    <!-- Issue 2.7 (FR-ACC-006): reconciling an account against a real statement. The copy has to
         carry P-02 — the user sees what the app holds, what they typed, and the rule between the
         two — because the adjustment it posts is a permanent row in their history. -->
    <string name="accounts_reconcile">Reconcile</string>
    <string name="accounts_reconcile_title">Reconcile %1$s</string>
    <string name="accounts_reconcile_app_balance">What the app has</string>
    <string name="accounts_reconcile_statement">Balance on your statement</string>
    <string name="accounts_reconcile_statement_help">Enter it exactly as your bank shows it. For a
        card or a loan, enter what you owe as a negative amount.</string>
    <string name="accounts_reconcile_adjustment">Adjustment</string>
    <!-- The rule that fired, in plain language (P-02). Shown even when the delta is zero. -->
    <string name="accounts_reconcile_rule">Adjustment = statement balance − app balance</string>
    <string name="accounts_reconcile_explain">This adds one adjustment transaction. Nothing already
        in your history is changed.</string>
    <string name="accounts_reconcile_in_step">The app already matches your statement. Nothing will
        be added.</string>
    <string name="accounts_reconcile_confirm">Post adjustment</string>
    <string name="accounts_reconcile_cancel">Cancel</string>

    <string name="account_editor_title_new">New account</string>
    <string name="account_editor_title_edit">Edit account</string>
    <string name="account_editor_name">Name</string>
    <string name="account_editor_name_hint">What you call it, e.g. HDFC Salary</string>
    <string name="account_editor_type">Type</string>
    <string name="account_editor_institution">Bank or provider (optional)</string>
    <string name="account_editor_opening_balance">Opening balance</string>
    <!-- Says plainly why the balance is not editable here: it is derived, not stated (DB-001). -->
    <string name="account_editor_opening_balance_help">What it held when you started tracking it.
        The current balance is worked out from your transactions.</string>
    <string name="account_editor_liability_help">For a card or a loan, enter what you owe as a
        negative amount.</string>
    <!-- Issue 2.6 (FR-ACC-005): the opt-out, for an account that is open but not yours to count. -->
    <string name="account_editor_include_in_networth">Count towards net worth</string>
    <string name="account_editor_include_in_networth_help">Turn this off for an account you use but
        do not own — a company card, or one you hold for someone else. It stays in your list either
        way.</string>
    <string name="account_editor_save">Save</string>
    <string name="account_editor_cancel">Cancel</string>
    <string name="account_editor_error_validation">Check what you entered - the name, the amounts, and any
        dates or days.</string>

    <!-- FR-ACC-001\'s eleven types. The stored codes live in AccountType; these are only labels. -->
    <string name="account_type_bank">Bank account</string>
    <string name="account_type_cash">Cash</string>
    <string name="account_type_credit_card">Credit card</string>
    <string name="account_type_loan">Loan</string>
    <string name="account_type_investment">Investment</string>
    <string name="account_type_gold">Gold</string>
    <string name="account_type_crypto">Crypto</string>
    <string name="account_type_property">Property</string>
    <string name="account_type_vehicle">Vehicle</string>
    <string name="account_type_receivable">Money owed to you</string>
    <string name="account_type_payable">Money you owe</string>

    <!-- Issue 6.1: credit-card terms (FR-ACC-002). Shown only when the type is a credit card - the
         first type branch in this module. The two days are days-of-month, not dates, because that
         is what a card bills on and what FR-ACC-002 stores. -->
    <string name="account_editor_card_section">Card details</string>
    <string name="account_editor_card_limit">Credit limit</string>
    <string name="account_editor_card_statement_day">Statement day</string>
    <string name="account_editor_card_due_day">Due day</string>
    <string name="account_editor_card_last_statement">Last statement amount</string>
    <string name="account_editor_card_minimum_due">Minimum due</string>
    <string name="account_editor_card_help">The limit and both days are needed together — without
        all three the app cannot work out your billing cycle. The statement amount and minimum are
        optional; add them and you\'ll get a reminder before the payment is due.</string>

    <!-- Issue 6.1: the utilisation bar on a credit-card row. The figure shown is the LIVE one -
         everything currently owed - and it says so, because the app also holds a statement figure
         that is deliberately different (P-02, ADR-0025). -->
    <string name="accounts_card_utilisation">%1$s of %2$s used now</string>
    <string name="accounts_card_utilisation_percent">%1$d%%</string>
    <string name="accounts_card_utilisation_description">Using %1$d%% of this card\'s limit right
        now. %2$s of %3$s.</string>
    <string name="accounts_card_due">Due %1$s</string>
    <string name="accounts_card_no_terms">Add this card\'s limit and dates</string>

    <!-- Issue 6.2 (FR-ACC-003): loan terms. Shown only when the type is a loan - the second type
         branch in this module. The rate is asked for in PERCENT because that is what the sanction
         letter says; it becomes basis points once, at save (MNY-002). The first EMI is a full date
         rather than a day-of-month, because a schedule is anchored: instalment 47 falls on a
         particular day of a particular year. -->
    <string name="account_editor_loan_section">Loan details</string>
    <string name="account_editor_loan_principal">Loan amount</string>
    <string name="account_editor_loan_rate">Interest rate (%)</string>
    <string name="account_editor_loan_tenure">Tenure (months)</string>
    <string name="account_editor_loan_first_emi">First EMI date (YYYY-MM-DD)</string>
    <string name="account_editor_loan_emi_override">Your bank\'s EMI (optional)</string>
    <string name="account_editor_loan_help">The amount, rate, tenure and first EMI date are needed
        together - without all four there is no schedule to work out. Leave the EMI blank and the app
        calculates it; enter your bank\'s own figure if it differs and the app will use that instead.</string>

    <!-- Issue 6.2: the next instalment on a loan row. Both halves of the split are shown and they
         sum to the EMI above them, so the reader can check the line rather than trust it (P-02). -->
    <string name="accounts_loan_next_emi">Next EMI %1$s on %2$s</string>
    <string name="accounts_loan_split">%1$s principal · %2$s interest</string>
    <string name="accounts_loan_next_emi_description">Next EMI %1$s, due %2$s. %3$s goes to
        principal and %4$s to interest.</string>
    <string name="accounts_loan_no_terms">Add this loan\'s amount, rate and tenure</string>

    <!-- Issue 6.3 (§11, AI-INV): holdings inside an investment account, their value and their
         money-weighted return. Every figure is shown beside the inputs it came from, so the reader
         can check the line rather than trust it (P-02). -->
    <string name="accounts_investments_value">%1$s across %2$s</string>
    <plurals name="accounts_investments_count">
        <item quantity="one">%d holding</item>
        <item quantity="other">%d holdings</item>
    </plurals>
    <string name="accounts_investments_none">Add what this account holds</string>
    <string name="accounts_investments_open">Holdings</string>

    <string name="holdings_title">Holdings</string>
    <string name="holdings_empty">Nothing here yet. Add a fund, a stock or a deposit and the app can
        work out what it is worth and what it has returned.</string>
    <string name="holdings_add">Add a holding</string>
    <string name="holdings_add_lot">Add a purchase or sale</string>
    <string name="holdings_delete">Delete</string>

    <!-- The value line. The units and the price are named beside the value because a value with
         neither is a figure the reader has no way to check (P-02). -->
    <string name="holdings_value">%1$s</string>
    <string name="holdings_units_at">%1$s units at %2$s</string>
    <string name="holdings_priced_on">Priced %1$s</string>
    <string name="holdings_unpriced">Not valued yet - add a price per unit</string>
    <string name="holdings_cost">%1$s invested</string>
    <string name="holdings_returned">%1$s returned</string>
    <string name="holdings_gain">%1$s gain</string>
    <string name="holdings_loss">%1$s loss</string>

    <!-- The return, and why there sometimes is not one. Each reason is its own string because each
         is a different thing for the user to do about it (P-02). -->
    <string name="holdings_return">%1$s a year</string>
    <string name="holdings_return_percent">%1$s%2$d.%3$d%%</string>
    <string name="holdings_return_over">over %1$s days, from %2$s</string>
    <plurals name="holdings_return_flows">
        <item quantity="one">%d cash flow</item>
        <item quantity="other">%d cash flows</item>
    </plurals>
    <string name="holdings_return_too_few">A return needs at least two dated amounts</string>
    <string name="holdings_return_same_sign">Add a price per unit, or a sale, to see a return</string>
    <string name="holdings_return_not_bracketed">This has fallen too far to annualise</string>

    <!-- The editor. -->
    <string name="holdings_name">Name</string>
    <string name="holdings_asset_class">Asset class</string>
    <string name="holdings_unit_price">Price per unit</string>
    <string name="holdings_priced_on_field">Priced on (YYYY-MM-DD)</string>
    <string name="holdings_lot_kind">Bought, sold or paid out</string>
    <string name="holdings_lot_date">Date (YYYY-MM-DD)</string>
    <string name="holdings_lot_units">Units</string>
    <string name="holdings_lot_amount">Amount</string>
    <string name="holdings_save">Save</string>
    <string name="holdings_cancel">Cancel</string>

    <string name="asset_class_equity">Equity</string>
    <string name="asset_class_debt">Debt</string>
    <string name="asset_class_gold">Gold</string>
    <string name="asset_class_crypto">Crypto</string>
    <string name="asset_class_cash">Cash</string>
    <string name="asset_class_real_estate">Property</string>
    <string name="asset_class_other">Other</string>

    <!-- Issue 6.4: allocation and diversification (FR-INV-002). The percentages are computed by
         the engine and only rendered here (P-03), and every warning names the rulebook row that
         raised it, because a warning nobody can trace is the black-box verdict P-02 forbids. -->
    <string name="allocation_title">Allocation</string>
    <string name="allocation_open">See allocation</string>
    <string name="allocation_total">%1$s invested</string>
    <string name="allocation_share">%1$s%%</string>
    <string name="allocation_legend_row">%1$s, %2$s, %3$s of the portfolio</string>
    <string name="allocation_bar_description">How your portfolio is split: %1$s</string>
    <string name="allocation_done">Done</string>

    <!-- The three empty states. Each names a different thing for the user to do, because "you have
         not invested yet" and "you have not priced what you hold" are different problems (P-03). -->
    <string name="allocation_empty_title">Nothing invested yet</string>
    <string name="allocation_empty_body">Add an investment, gold or crypto account and what it
        holds, and the split will appear here.</string>
    <string name="allocation_unpriced_title">Nothing is priced yet</string>
    <string name="allocation_unpriced_body">Add a price per unit to what you hold and the split
        will appear here. We will not guess a value you have not given us.</string>
    <string name="allocation_error">We could not read your holdings just now.</string>

    <!-- Coverage. A split computed over part of the portfolio says so (P-02). -->
    <plurals name="allocation_unvalued">
        <item quantity="one">Based on %1$d of %2$d holdings - one has no price yet</item>
        <item quantity="other">Based on %1$d of %2$d holdings - %3$d have no price yet</item>
    </plurals>

    <!-- The concentration warnings. Observations with their numbers, never instructions (P-07). -->
    <string name="allocation_flags_title">Worth a look</string>
    <string name="allocation_flags_none">Nothing is over the limits we check.</string>
    <string name="allocation_flag_class_cap">%1$s is %2$s of your portfolio, above the %3$s we
        flag at</string>
    <string name="allocation_flag_single_class">%1$s is %2$s of your portfolio, above the %3$s we
        flag at for one asset class</string>
    <string name="allocation_flag_single_holding">%1$s is %2$s of your portfolio, above the %3$s we
        flag at for one holding</string>
    <string name="allocation_flag_amount">%1$s</string>
    <string name="allocation_reason_rule">Rule %1$s v%2$s</string>

    <string name="lot_kind_buy">Bought</string>
    <string name="lot_kind_sell">Sold</string>
    <string name="lot_kind_income">Dividend or interest</string>

    <!-- §11.1 requires this wording in the module footer, and issue 6.3 is what first puts an
         investment figure on screen. It is not decoration: the app analyses and flags, it does not
         recommend securities, and it is not SEBI-registered advice (P-07). -->
    <string name="holdings_disclaimer">This screen analyses and explains what you already own. It
        does not recommend specific securities or funds, and it is not SEBI-registered investment
        advice. Every figure here is computed from what you entered - tap a number to see its
        inputs.</string>
</resources>
