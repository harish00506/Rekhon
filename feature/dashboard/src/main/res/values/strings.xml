<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard copy (§21.6, ACC-*).

  Why:  every user-visible string lives here, not in a composable — so it can be translated, use
        ICU plurals, and be reviewed for tone and accessibility. The CfoHardcodedUiString lint rule
        from issue 1.5 fails the build on a literal in a :feature:* Text(...).
  Note: the content descriptions are written as full sentences because a screen reader reads them
        aloud in place of the figure, and "1,23,456" alone tells a non-sighted user nothing.
-->
<resources>
    <string name="dashboard_title">Dashboard</string>
    <string name="dashboard_safe_to_spend_label">Safe to spend</string>
    <string name="dashboard_net_worth_label">Net worth</string>
    <string name="dashboard_spend_split_label">This month</string>
    <!-- Issue 4.4: the way from the nature-level bar above to the category-level plan behind it. -->
    <string name="dashboard_budgets_action">Your budgets</string>
    <string name="dashboard_accounts_action">Your accounts</string>
    <string name="dashboard_transactions_action">View transactions</string>
    <string name="dashboard_refresh_action">Refresh</string>
    <string name="dashboard_loading">Working out your position…</string>
    <string name="dashboard_error">Something went wrong. Pull to refresh.</string>
    <string name="dashboard_safe_to_spend_description">Safe to spend this month</string>
    <string name="dashboard_net_worth_description">Your net worth</string>
    <!-- Issue 2.6: shown before the first daily snapshot has been taken. Never rendered as ₹0. -->
    <string name="dashboard_net_worth_pending">Not worked out yet — we\'ll have it after your first daily update.</string>
    <string name="dashboard_spend_split_description">Spending split between needs, wants and savings</string>
    <!-- Issue 2.3: shown when the user skipped quick setup, so there is no budget to chart. -->
    <string name="dashboard_spend_split_empty">No budget yet. Add your monthly income in Settings and we\'ll suggest one.</string>

    <!--
      Issue 4.3 — §8.3's true-spend split, beside the budget above it.

      The debt note is not boilerplate: §8.3's formula is NEED + WANT + interest/fees, and this build
      cannot split an EMI into principal and interest (no amortisation rows — ADR-0016), so the
      figure is short by exactly that interest. P-02 says show the work, and a number the user is
      told is incomplete is a different thing from one they are not.
    -->
    <string name="dashboard_actual_label">This month, actually</string>
    <string name="dashboard_actual_values">Needs %1$s · Wants %2$s · Kept %3$s</string>
    <string name="dashboard_actual_debt_note">Loan repayments are shown separately and aren\'t counted as spending yet.</string>

    <!-- Issue 5.1 — this month's cash flow, beside the plan/actual pair above it. -->
    <string name="dashboard_cash_flow_label">This month\'s cash flow</string>
    <string name="dashboard_cash_flow_values">Received %1$s · Spent %2$s</string>

    <!--
      Issue 5.1 — the budget summary card. The alert line cites its rule (P-02), matching how
      :feature:budgets' own banner does for the same alert — a figure the dashboard did not compute
      and must not repeat without saying where it came from.
    -->
    <string name="dashboard_budget_status_label">Your budget this month</string>
    <string name="dashboard_budget_status_values">%1$s of %2$s spent</string>
    <string name="dashboard_budget_status_empty">No budgets set yet. Set one from Your budgets.</string>
    <plurals name="dashboard_budget_alerts">
        <item quantity="one">%1$d category needs attention</item>
        <item quantity="other">%1$d categories need attention</item>
    </plurals>
    <string name="dashboard_reason_rule">Rule %1$s v%2$s</string>

    <!-- Issue 5.1 — the recent-activity preview; the full ledger is "View transactions" above. -->
    <string name="dashboard_recent_activity_label">Recent activity</string>
    <string name="dashboard_recent_activity_empty">No transactions yet.</string>
    <string name="dashboard_recent_activity_unnamed">Transaction</string>
</resources>
