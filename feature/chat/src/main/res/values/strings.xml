    <string name="chat_you">You asked</string>

    <string name="chat_refusal_out_of_scope">I can\'t help with that one — no stock tips, tax filing or legal advice. Here is what I can do.</string>
    <string name="chat_refusal_not_understood">I did not follow that. Try one of these.</string>
