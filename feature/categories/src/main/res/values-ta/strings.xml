    <string name="categories_delete_counting">இந்த வகையை எவை பயன்படுத்துகின்றன எனப் பார்க்கிறோம்…</string>
    <string name="categories_delete_unknown_usage">இந்த வகையை எவை பயன்படுத்துகின்றன எனச் சரிபார்க்க முடியவில்லை. இது நீக்கப்படும், இதைப் பயன்படுத்தியவை வகைப்படுத்தப்படாதவை எனக் காட்டப்படும்.</string>
    <plurals name="categories_delete_usage">
        <item quantity="one">%1$d பரிவர்த்தனை இந்த வகையைப் பயன்படுத்துகிறது; அது வகைப்படுத்தப்படாதது எனக் காட்டப்படும். எதுவும் நீக்கப்படாது, எந்தத் தொகையும் மாறாது.</item>
        <item quantity="other">%1$d பரிவர்த்தனைகள் இந்த வகையைப் பயன்படுத்துகின்றன; அவை வகைப்படுத்தப்படாதவை எனக் காட்டப்படும். எதுவும் நீக்கப்படாது, எந்தத் தொகையும் மாறாது.</item>
    </plurals>
