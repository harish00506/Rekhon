<resources>
    <string name="market_title">இன்று முதலீடு செய்ய நல்ல நாளா?</string>
    <string name="market_intro">உண்மையில் அளக்க முடிந்தவற்றில் ஒரு மதிப்பெண் — இந்த ஆப் ஏற்கெனவே சேமித்த விலைகளிலிருந்தே. இதே தீர்ப்புக்குப் பிறகு எத்தனை முறை விலை உயர்ந்தது என்பதோடு காட்டப்படுகிறது — இது எதையும் வாங்குவதில்லை.</string>
    <string name="market_empty">இன்னும் மதிப்பெண் தர எதுவும் இல்லை. விலைக் குறியீடு உள்ள முதலீட்டைச் சேர்த்தால், விலைகள் வரவர வரலாறு உருவாகும்.</string>
    <string name="market_verdict_strong">இன்று முதலீட்டுக்கு வலுவான நாளாகத் தெரிகிறது.</string>
